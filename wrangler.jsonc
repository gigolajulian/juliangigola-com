{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // The Worker that serves the site. Renaming this creates a second Worker
  // rather than renaming the first, so the custom domain would have to be
  // moved by hand — it is effectively permanent.
  "name": "juliangigola",

  "main": ".open-next/worker.js",

  // Must be 2024-09-23 or later for the adapter. `nodejs_compat` is not
  // optional: Next's server code reaches for Node built-ins, and without the
  // flag the Worker fails at import time rather than at a request.
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],

  // Julian: the homepage took 0.1s to 1.15s to start answering, every
  // request a page-cache hit, because every request still ran the Worker
  // (2026-10-13, 12 samples). Workers Caching answers from the edge
  // without running it. The pages already say how to keep them
  // (`s-maxage`, a year), and `Vary` keeps a page and its RSC payloads
  // apart; the APIs say `no-store` and pass through. The version is in the
  // key, so a deploy never serves the last build's HTML against this
  // build's chunks. A Cache Rule in the dashboard cannot do this: on a
  // custom domain the Worker is the origin, in front of the zone's cache.
  "cache": { "enabled": true },

  // Everything `next build` emits as a file — the photographs in
  // `public/hero` and `public/covers`, the JS chunks, the prerendered HTML.
  // Requests that resolve to one of these are served straight off
  // Cloudflare's edge without invoking the Worker, and are free and
  // unmetered. The archive itself is not here; it lives in R2, see
  // `image-loader.ts`.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Where the contact form's enquiries are kept, and what /admin's Inbox
  // reads. One entry per enquiry, plus a short-lived key per sender for the
  // five-minute cooldown and a counter per day for the ceiling behind it.
  //
  // KV rather than D1 because nothing here is relational: an enquiry is
  // written once, read a few times and deleted. It is also the one store on
  // the free plan whose limits are nowhere near what a photographer receives
  // — and the cooldown and the daily cap in `lib/inbox.ts` exist to keep
  // somebody else's script from spending that allowance.
  /* Cloudflare Email Sending. Each enquiry the form stores is also mailed
     to Julian, from `enquiries@notifications.juliangigola.com` — a sending
     subdomain onboarded on 2026-09-13 so the apex's own mail records, which
     are Google's, were never touched. `destination_address` pins the
     binding to the one address it may send to; `to` is left off the call
     and the binding fills it in. The address had to be verified once
     (Cloudflare emailed it a link). */
  "send_email": [
    { "name": "EMAIL", "destination_address": "hello@juliangigola.com" }
  ],

  /* The site's own click-and-scroll beacon (`app/api/beacon`), read back by
     /admin's SEO tab. Analytics Engine: free to write, kept three months,
     queried with the same CF_ANALYTICS_TOKEN. No cookie, no id, no IP. */
  "analytics_engine_datasets": [
    { "binding": "BEACON", "dataset": "jg_beacon" }
  ],

  "kv_namespaces": [
    {
      "binding": "INBOX",
      "id": "e88c837945d84ec4b4fdb889c09149fe"
    }
  ],

  // Worker logs, so `wrangler tail` has something to show when a Server
  // Action fails in production.
  "observability": {
    "enabled": true
  }
}
