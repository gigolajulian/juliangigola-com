{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // The Worker that serves the site. Renaming this creates a second Worker
  // rather than renaming the first, so the custom domain would have to be
  // moved by hand — it is effectively permanent.
  "name": "juliangigola",

  "main": ".open-next/worker.js",

  // Must be 2024-09-23 or later for the adapter. `nodejs_compat` is not
  // optional: Next's server code reaches for Node built-ins, and without the
  // flag the Worker fails at import time rather than at a request.
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],

  // Everything `next build` emits as a file — the photographs in
  // `public/hero` and `public/covers`, the JS chunks, the prerendered HTML.
  // Requests that resolve to one of these are served straight off
  // Cloudflare's edge without invoking the Worker, and are free and
  // unmetered. The archive itself is not here; it lives in R2, see
  // `image-loader.ts`.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Where the contact form's enquiries are kept, and what /admin's Inbox
  // reads. One entry per enquiry, plus a short-lived key per sender for the
  // five-minute cooldown and a counter per day for the ceiling behind it.
  //
  // KV rather than D1 because nothing here is relational: an enquiry is
  // written once, read a few times and deleted. It is also the one store on
  // the free plan whose limits are nowhere near what a photographer receives
  // — and the cooldown and the daily cap in `lib/inbox.ts` exist to keep
  // somebody else's script from spending that allowance.
  "kv_namespaces": [
    {
      "binding": "INBOX",
      "id": "e88c837945d84ec4b4fdb889c09149fe"
    }
  ],

  // Worker logs, so `wrangler tail` has something to show when a Server
  // Action fails in production.
  "observability": {
    "enabled": true
  }
}
