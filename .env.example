# Names only, no values. Bindings (KV, R2, mail, Durable Object, Images,
# rate limits) are in wrangler.jsonc and need nothing here.

# Secrets: set on the Worker with `npx wrangler versions secret put <NAME>`,
# or in .dev.vars for `wrangler dev`. Never commit a value.
INBOX_KEY=              # opens /admin Inbox and the desks (lib/vouch.ts)
LEADS_KEY=              # seals lead, proof and contract records in KV
VAPID_KEY=              # web push to the Leads desk
BOOKING_SECRET=         # signs the booking links
WORKER_KEY=             # the bearer for booking worker -> site calls
GCAL_OAUTH=             # Google Calendar, Gmail and the Sheet copy
GSC_OAUTH=              # Search Console for /admin SEO
BING_API_KEY=           # Bing Webmaster for /admin SEO
CF_ANALYTICS_TOKEN=     # Cloudflare analytics for /admin Traffic
NOTION_TOKEN=           # Notion Business Hub sync
STRIPE_SECRET_KEY=      # deposits
STRIPE_WEBHOOK_SECRET=  # app/api/stripe

# Public, read at build time (not secrets).
NEXT_PUBLIC_STRIPE_PK=
NEXT_PUBLIC_IMAGE_CDN=          # 1 in .env.production; 0 for a local prod preview
NEXT_PUBLIC_IMAGE_CDN_ORIGIN=   # branch previews ask the live zone for photos
