# Security headers, for the responses the Worker never sees.
#
# `next.config.ts` declares the same set, and that covers anything Next
# renders. It does not cover everything: `wrangler.jsonc` points the ASSETS
# binding at the build output, and a request resolving to a static file is
# served straight off Cloudflare's edge without invoking the Worker at all —
# which is most of this site, since every page here is prerendered. Headers
# declared in Next would simply not be on those responses.
#
# So they are declared twice, in the two places that can serve a response.
# Keep the two in step; `next.config.ts` carries the reasoning for each one.
#
# Cloudflare Workers Static Assets reads this file from the root of the assets
# directory. `next build` copies `public/` into the output, so this lands
# where it needs to be.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.github.com; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
