# Read by `next build` and nothing else — `next dev` never sees it, so local
# images keep coming from disk. Committed on purpose (see .gitignore): it is
# not a secret, it is the one line that turns the site's photographs over to
# Cloudflare Image Transformations, enabled on the zone on 2026-09-13.
NEXT_PUBLIC_IMAGE_CDN=1

# Which engine the booking picker uses: "cal" until cutover, then "own",
# together with BOOKING_ENGINE in wrangler.jsonc (lib/booking-rules.ts).
NEXT_PUBLIC_BOOKING_ENGINE=cal
