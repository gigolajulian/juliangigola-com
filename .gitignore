# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# harvest cache
/.harvest-cache/

# source drops — full-resolution originals, not needed by the build
/PICS/

# machine-local Claude Code settings
.claude/settings.local.json

# static export output
/out/

# Cloudflare Workers build output
/.open-next/
/.wrangler/

# The harvested archive. ~690MB at 2500px, and git keeps every version of
# every blob forever — committing it once would make every clone pay for it
# for good. It lives in R2 instead; `lib/work-data.ts` is the manifest that
# points at it, and `scripts/sync-r2.mjs` pushes it after a harvest.
#
# `public/hero/` and `public/covers/` are NOT ignored: a few megabytes of
# hand-picked frames that ship with the app.
/public/work/
